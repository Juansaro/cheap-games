[Unit]
Description=cheap-games catalog API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/cheap-games
Environment=PORT=8787
Environment=HOST=0.0.0.0
Environment=CORS_ORIGINS=https://juansaro.github.io
Environment=NODE_OPTIONS=--experimental-sqlite
ExecStart=/usr/bin/node server/api.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
